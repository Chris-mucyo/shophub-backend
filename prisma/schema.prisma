generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RETAILER
  WHOLESALER
  ADMIN
}

enum UserStatus {
  PENDING_EMAIL_VERIFICATION
  PENDING_PHONE_VERIFICATION
  PENDING_PROFILE
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
  DELETED
}

enum WholesalerStatus {
  NOT_APPLIED
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  FULFILLED
  COMPLETED
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  ORDER
  SYSTEM
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  phone            String           @unique
  password         String?
  fullName         String
  status           UserStatus       @default(PENDING_EMAIL_VERIFICATION)
  emailVerified    Boolean          @default(false)
  phoneVerified    Boolean          @default(false)
  role             Role             @default(RETAILER)
  wholesalerStatus WholesalerStatus @default(NOT_APPLIED)
  googleId         String?          @unique

  // KYC / Profile fields
  nationalIdNumber String? @unique
  nationalIdImage  String?
  selfieImage      String?
  addressDistrict  String?
  addressSector    String?
  addressCell      String?
  addressVillage   String?
  proofOfAddress   String?

  // Wholesaler business fields
  businessName     String?
  tin              String? @unique
  businessRegNo    String?
  businessAddress  String?
  businessCategory String?
  businessDocUrl   String?

  profileSubmittedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  shop                Shop?
  orders              Order[]
  sentMessages        Message[]       @relation("Sender")
  receivedMessages    Message[]       @relation("Receiver")
  follows             Follow[]        @relation("Follower")
  likes               Like[]
  comments            Comment[]
  notifications       Notification[]  @relation("UserNotifications")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Shop {
  id              String    @id @default(uuid())
  name            String
  description     String?
  bio             String?
  avatarUrl       String?
  coverPhotoUrl   String?
  category        String?
  location        String?
  website         String?
  socialLinks     Json?
  followersCount  Int       @default(0)
  productsCount   Int       @default(0)
  ownerId         String    @unique
  owner           User      @relation(fields: [ownerId], references: [id])
  products        Product[]
  followers       Follow[]  @relation("ShopFollowers")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category])
  @@index([location])
}

model Product {
  id            String      @id @default(uuid())
  name          String
  description   String?
  caption       String?
  tags          String[]
  price         Decimal     @db.Decimal(10, 2)
  stock         Int         @default(0)
  shopId        String
  shop          Shop        @relation(fields: [shopId], references: [id])
  images        String[]
  likeCount     Int         @default(0)
  commentCount  Int         @default(0)
  orders        Order[]
  likes         Like[]
  comments      Comment[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([shopId])
  @@index([createdAt])
}

model Order {
  id         String      @id @default(uuid())
  retailerId String
  retailer   User        @relation(fields: [retailerId], references: [id])
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  quantity   Int
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Follow {
  id        String   @id @default(uuid())
  followerId String
  follower  User     @relation("Follower", fields: [followerId], references: [id])
  shopId    String
  shop      Shop     @relation("ShopFollowers", fields: [shopId], references: [id])
  createdAt DateTime @default(now())

  @@unique([followerId, shopId])
  @@index([shopId])
  @@index([followerId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([userId])
}

model Notification {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation("UserNotifications", fields: [userId], references: [id])
  type      NotificationType
  message   String
  read      Boolean           @default(false)
  createdAt DateTime          @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  sender     User     @relation("Sender", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id])
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}